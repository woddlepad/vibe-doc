# Claude subscription token for the Agent SDK. Create it with: claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# Exa API key, needed only by harnesses with max_lookups > 0 (the doctor's web lookup tool).
EXA_API_KEY=

# Doctor Live web demo: uv run rsi live (no Claude token required for this demo).
# Keep this server-side; never put an API key in browser code.
OPENAI_API_KEY=
# Optional shared password for an HTTPS demo. Leave empty for local-only use.
RSI_LIVE_PASSWORD=
# Optional: must be a Realtime API model available to your OpenAI project.
# RSI_REALTIME_MODEL=gpt-realtime
# Used by the separate examiner selector and diagnosis grader.
# RSI_LIVE_HELPER_MODEL=gpt-4.1-mini

# Optional model overrides for the frozen roles and the optimizer.
# The doctor's model lives in harnesses/vNNN/config.json (locked across versions).
# RSI_PATIENT_MODEL=claude-haiku-5-5
# RSI_EXAMINER_MODEL=claude-haiku-5-5
# RSI_JUDGE_MODEL=claude-sonnet-5-5
# RSI_OPTIMIZER_MODEL=claude-opus-5-5
